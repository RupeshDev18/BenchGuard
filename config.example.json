{
  "openapiPath": "sample-openapi.json",
  "baseUrl": "http://localhost:8080",
  "headers": {
    "Authorization": "Bearer sample-jwt-token-xyz-123",
    "X-Test-Source": "k6-enterprise-pipeline"
  },
  "load": {
    "mode": "stages",
    "stages": [
      { "duration": "5s", "target": 10 },
      { "duration": "10s", "target": 25 },
      { "duration": "5s", "target": 0 }
    ],
    "vus": 20,
    "duration": "30s"
  },
  "thresholds": {
    "p95Ms": 350,
    "p99Ms": 600,
    "maxErrorRate": 0.02
  },
  "endpoints": {
    "include": ["all"],
    "exclude": []
  },
  "contractTesting": {
    "enabled": false,
    "note": "Set enabled:true and install schemathesis via pip to enable automated contract checks against openapi schema."
  },
  "run": {
    "buildLabel": "v1.4.2-rel",
    "environment": "staging",
    "projectName": "Spring Boot E-Commerce Microservice",
    "executedBy": "Performance Engineering Team"
  }
}
